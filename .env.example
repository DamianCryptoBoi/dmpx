# On a server, scripts/setup_server.sh creates .env for you. Locally: copy to
# .env, chmod 600, then generate the admin hash, session secret, and API key:
#   uv run scripts/setup_admin.py --write

# Bearer key your Cloudflare Worker sends. /v1 is disabled while empty.
DREAMINA_API_KEY=
# PBKDF2 hash of the dashboard password (never the password itself).
ADMIN_PASSWORD_HASH=
# Signs dashboard sessions. Changing it logs the admin out.
DREAMINA_SESSION_SECRET=

# Storage. Production: /var/lib/dreamina (created 0700).
DREAMINA_DATA_DIR=.data
# ShardX engine/fingerprint cache; defaults to ./.shardx
# DREAMINA_SHARDX_CACHE_DIR=/var/lib/dreamina/shardx
# Desktop fingerprint family for new profiles: windows (default), mac, linux.
# DREAMINA_SHARD_PLATFORM=windows

# Accounts. Usually added from the dashboard, which writes them here. The id
# is lowercase letters, digits, and single dashes; the env key is the id
# upper-cased with dashes as underscores.
# DREAMINA_ACCOUNT_MAIN_EMAIL=you@example.com
# DREAMINA_ACCOUNT_MAIN_PASSWORD=change-me

# Tuning (defaults shown).
# DREAMINA_MEDIA_RETENTION_DAYS=7       # failure screenshots; videos are never stored
# DREAMINA_MAX_CONCURRENT_JOBS=2        # simultaneous browser submissions
# DREAMINA_BROWSER_IDLE_SECONDS=600     # close an account's browser after idling
# DREAMINA_GENERATION_TIMEOUT_SECONDS=600 # page prep + uploads before the submit click
# DREAMINA_POLL_INTERVAL_SECONDS=15
# DREAMINA_POLL_TIMEOUT_SECONDS=900
# DREAMINA_MAX_IMAGE_BYTES=20971520
# DREAMINA_MAX_AUDIO_BYTES=15728640
# DREAMINA_MAX_REQUEST_BYTES=62914560
# DREAMINA_SESSION_TTL_HOURS=12
# DREAMINA_LOG_LEVEL=INFO
# DREAMINA_TRUSTED_PROXIES=             # hosts allowed to set CF-Connecting-IP besides loopback
# DREAMINA_BROWSER_ARGS=                # extra Chromium flags, e.g. --no-sandbox if the sandbox is refused
# Local development over plain http only; production cookies are Secure.
# DREAMINA_INSECURE_COOKIES=1
